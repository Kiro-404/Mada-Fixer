# ─── Primary: Meta Model API ─────────────────────────────────────────────────
# Get your key at https://dev.meta.ai  (requires payment method)
MODEL_API_KEY=
API_BASE=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
USE_SAM=1

# ─── Automatic Fallback (free, no credit card needed) ────────────────────────
# If Meta API fails or MODEL_API_KEY is empty, the agent retries on this route.
# Recommended: Groq  →  sign up free at https://console.groq.com
#
FALLBACK_API_BASE=https://api.groq.com/openai/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=llama-3.3-70b-versatile
FALLBACK_LABEL=groq
#
# Other free options:
#   Together AI  → https://api.together.ai/v1  (FALLBACK_MODEL=meta-llama/Llama-3-70b-chat-hf)
#   OpenRouter   → https://openrouter.ai/api/v1 (FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct)

# ─── Agent settings ───────────────────────────────────────────────────────────
MIN_CONFIDENCE=0.6

# ─── Optional: open-weights first-draft route (Baseten / Modal) ───────────────
USE_OPEN=0
OPEN_API_BASE=
OPEN_API_KEY=
OPEN_MODEL=meta-models/muse-spark-open-1026
