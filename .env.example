# Meta Model API (https://dev.meta.ai). Copy this file to .env and paste your key.
# .env is git-ignored: never commit a real key.
MODEL_API_KEY=
API_BASE=https://api.meta.ai/v1

# Models (hackathon model ids; see dev.meta.ai/docs/models)
SPARK_MODEL=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1

# What to run
USE_SAM=1                 # 0 disables the SAM 3.1 visual discovery pass
MIN_CONFIDENCE=0.6        # below this a fix goes to human review instead of being applied
HEADLESS=1                # 0 shows the browser (useful when recording the demo)
# CHROMIUM_PATH=
# CHROMIUM_ARGS=

# Model limits (cost control)
MODEL_CONCURRENCY=4
MAX_MODEL_CALLS=400
MAX_INPUT_TOKENS=2000000
MODEL_TIMEOUT_MS=90000
NO_CACHE=0                # 1 disables .cache (tests use this)
# PRICE_IN=1.25           # USD per 1M input tokens
# PRICE_OUT=4.25          # USD per 1M output tokens
# PRICE_SAM=2.5           # USD per 1000 SAM images

# Browser / page timing (milliseconds)
PAGE_TIMEOUT_MS=15000
NAV_TIMEOUT_MS=45000
IDLE_TIMEOUT_MS=4000
SAM_SCREENS=3
SAM_CONCEPTS=icon,logo,button,image
MAX_ATTEMPTS=3

# Source patching
PATCH_MAX_FILES=20
PATCH_MAX_FILE_CHARS=60000
PATCH_MAX_PAYLOAD_CHARS=150000
PATCH_ROUNDS=2

# Evaluation (npm run eval)
EVAL_DELAY_MS=2000
EVAL_TIMEOUT_MS=45000
# MADA_USER_AGENT="MadaFixer/0.1 (Arabic accessibility audit; read-only)"
