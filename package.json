{
  "name": "mada-fixer",
  "version": "0.1.0",
  "description": "Arabic accessibility agent: finds, fixes and verifies WCAG issues on Arabic sites with Meta models (Muse Spark, Muse Wonder, SAM 3.1).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fix": "tsx cli.ts",
    "check": "tsx scripts/check-models.ts",
    "typecheck": "tsc --noEmit",
    "units": "tsx test/units.ts",
    "smoke": "tsx test/smoke.ts",
    "robust": "tsx test/robust.ts",
    "test": "npm run typecheck && npm run units && npm run smoke && npm run robust",
    "eval": "tsx eval/run-eval.ts"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "diff": "8.0.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/pngjs": "6.0.5"
  }
}
